{
  "name": "dsh-forge",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Typed, safe developer tool plugins for DeepSeek Harness",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r run build",
    "clean": "pnpm -r exec rimraf dist coverage || true",
    "supply-chain": "node scripts/supply-chain-check.ts",
    "review:pr": "node scripts/review-pr.ts"
  },
  "devDependencies": {
    "@dsh-forge/core": "workspace:*",
    "@dsh-forge/plugin-ast-grep": "workspace:*",
    "@dsh-forge/plugin-ruff": "workspace:*",
    "@dsh-forge/plugin-biome": "workspace:*",
    "@dsh-forge/plugin-uv": "workspace:*",
    "@dsh-forge/plugin-act": "workspace:*",
    "@dsh-forge/plugin-semgrep": "workspace:*",
    "@dsh-forge/plugin-trivy": "workspace:*",
    "@dsh-forge/plugin-docker": "workspace:*",
    "@dsh-forge/plugin-k6": "workspace:*",
    "@dsh-forge/plugin-ffmpeg": "workspace:*",
    "@dsh-forge/plugin-quality-gate": "workspace:*",
    "@dsh-forge/presets": "workspace:*",
    "@eslint/js": "^9.30.0",
    "@types/estree": "^1.0.7",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
