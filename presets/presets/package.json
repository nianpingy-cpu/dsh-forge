{
  "name": "@dsh-forge/presets",
  "version": "0.2.0",
  "description": "Composable plugin presets for DeepSeek Harness (composition/config only; no plugin code duplication)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@dsh-forge/core": "workspace:*",
    "@dsh-forge/plugin-act": "workspace:*",
    "@dsh-forge/plugin-ast-grep": "workspace:*",
    "@dsh-forge/plugin-biome": "workspace:*",
    "@dsh-forge/plugin-docker": "workspace:*",
    "@dsh-forge/plugin-ffmpeg": "workspace:*",
    "@dsh-forge/plugin-k6": "workspace:*",
    "@dsh-forge/plugin-quality-gate": "workspace:*",
    "@dsh-forge/plugin-ruff": "workspace:*",
    "@dsh-forge/plugin-semgrep": "workspace:*",
    "@dsh-forge/plugin-trivy": "workspace:*",
    "@dsh-forge/plugin-uv": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
